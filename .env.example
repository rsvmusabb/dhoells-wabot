# ============================================================
# .env.example — Template Environment Variables
# Copy file ini jadi .env lalu isi dengan value kamu sendiri
# ============================================================

# Gemini API Keys (bisa 1 atau lebih, pisah pakai koma)
# Daftar di: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=key1,key2,key3

# ElevenLabs TTS (opsional - untuk suara AI premium)
# Daftar di: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Fish Audio TTS (opsional - untuk voice cloning)
# Daftar di: https://fish.audio
FISH_API_KEY=sk-fish-your_key_here
FISH_MODEL_ID=your_model_id_here
